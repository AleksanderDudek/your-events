# Only .local variants should stay out of the repo
.env.local
.env.development.local
.env.test.local
.env.production.local

# Certificates
*.pem

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

