{
  "name": "your-events",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "VITE_BASE_PATH= react-router build && serve out",
    "start": "npm run preview",
    "lint": "eslint src/ build-tools/",
    "type-check": "react-router typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:export": "playwright test --config=playwright.export.config.ts",
    "prepare": "husky"
  },
